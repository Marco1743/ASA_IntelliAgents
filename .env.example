
HOST="https://deliveroojs.bears.disi.unitn.it/"
TOKEN=valid-token

# Agent B (LLM) — its own player token, plus the hosted LLM (LiteLLM) access.
LLM_TOKEN=valid-token-for-agent-B
LITELLM_BASE_URL="https://llm.bears.disi.unitn.it/v1"
LITELLM_API_KEY=your-litellm-key
LLM_MODEL=llama-3.3-70b-lmstudio

# L3 coordination: a shared password so the two players (A and B) recognise each
# other on the game message bus. BOTH agents must be launched with the SAME value.
TEAM_SECRET=asa-team

# Optional PDDL extension (project requirement). A* always drives the agent; with
# this ON, PDDL runs in the BACKGROUND and refines the plan when it can (never
# blocks). Build the local solver once with `npm run setup:pddl`.
BDI_USE_PDDL=false

# Which PDDL solver to use when BDI_USE_PDDL=true:
#   fd     (default) — local Fast Downward binary (fast, offline)
#   online           — the course's planning.domains HTTP solver (slow; comparison only)
PDDL_SOLVER=fd

# How PDDL is used when BDI_USE_PDDL=true:
#   background (default) — A* drives, PDDL refines asynchronously (never blocks).
#                          On small/fast maps A* usually moves first, so you rarely
#                          see a refinement applied (FD still logs each solve).
#   primary              — PDDL plans every route (A* only as fallback). Blocks ~1s
#                          per plan but you SEE PDDL drive the agent (good for demos).
PDDL_MODE=background

# Fast Downward knobs (only used by PDDL_SOLVER=fd):
# PYTHON_CMD=python                 # your Python 3 launcher (also used by setup:pddl)
# DOWNWARD_PATH=lib/downward/fast-downward.py
# FD_SEARCH=astar(blind())          # Fast Downward search config
# AGENT_INSTANCE=A                  # per-process tag so two agents don't share PDDL temp files

# For PDDL_SOLVER=online, you can point the library at a LOCAL planning.domains
# service instead of the public one:
# PAAS_HOST=http://localhost:5001
